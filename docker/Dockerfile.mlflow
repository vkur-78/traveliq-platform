# ============================================================
# TRAVELIQ — MLflow Tracking Server & Model Registry Container
# Image: traveliq-mlflow:2.0
# Build: docker build -f docker/Dockerfile.mlflow -t traveliq-mlflow:2.0 .
# ============================================================

FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /mlflow

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        curl \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --upgrade pip \
    && pip install mlflow==3.18.0 skops==0.16.0

RUN useradd --create-home --shell /bin/bash mlflowuser \
    && mkdir -p /mlflow/artifacts \
    && chown -R mlflowuser:mlflowuser /mlflow
USER mlflowuser

EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl --fail --silent http://127.0.0.1:5000/health || exit 1

CMD ["mlflow", "server", "--host", "0.0.0.0", "--port", "5000", "--backend-store-uri", "sqlite:////mlflow/mlflow.db", "--default-artifact-root", "/mlflow/artifacts", "--allowed-hosts", "localhost:*,127.0.0.1:*,mlflow:5000,traveliq-mlflow:5000,host.docker.internal:5000"]
