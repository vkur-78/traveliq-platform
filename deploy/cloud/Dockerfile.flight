# TRAVELIQ — Lean Production Flight Price API Container (Render Free Tier: ~120 MB RAM)
# Exposes ONLY /health and /predict over HTTPS (MLflow admin UI NOT included or exposed).

FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    MLFLOW_TRACKING_URI=disabled \
    ENABLE_LOCAL_MODEL_FALLBACK=1 \
    MODEL_NAME=Voyage_Flight_Price_Model \
    MODEL_ALIAS=champion

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    flask==3.1.3 \
    gunicorn==23.0.0 \
    joblib==1.6.0 \
    lightgbm==4.7.0 \
    numpy==2.5.5 \
    pandas==3.1.1 \
    scikit-learn==1.9.1 \
    scipy==1.18.1

COPY app/__init__.py ./app/__init__.py
COPY app/config.py ./app/config.py
COPY app/app.py ./app/app.py
COPY models/flight_price_pipeline.joblib ./models/flight_price_pipeline.joblib

RUN useradd --create-home --shell /bin/bash appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 5001

CMD ["sh", "-c", "exec gunicorn --bind 0.0.0.0:${PORT:-5001} --workers 1 --threads 4 --timeout 60 app.app:app"]
